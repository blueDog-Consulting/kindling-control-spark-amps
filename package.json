{
  "name": "kindling-control",
  "version": "0.1.0",
  "private": true,
  "description": "KindlingControl: an open controller for Positive Grid Spark amps. Re-implements the Bluetooth protocol, with web, desktop and mobile apps.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "node tools/serve.js",
    "decode": "node tools/btsnoop-decode.js",
    "deploy": "wrangler deploy",
    "desktop": "electron .",
    "desktop:mock": "electron . --mock",
    "desktop:dist": "electron-builder",
    "mobile:sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios",
    "check:docs": "node tools/check-docs.js",
    "release:plan": "node tools/release-plan.js",
    "icons": "node tools/build-icons.js"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.js",
  "author": "Jeremy Meiss",
  "homepage": "https://github.com/jerdog/positive-grid-spark",
  "build": {
    "appId": "io.github.jerdog.kindlingcontrol",
    "productName": "KindlingControl",
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "KindlingControl uses Bluetooth to talk to your Spark amp."
      },
      "icon": "build/icon-mac.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "maintainer": "jerdog <jerdog@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "artifactName": "kindling-control-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@resvg/resvg-js": "2.6.2",
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  },
  "desktopName": "kindling-control.desktop"
}
