{
  "name": "spark-control",
  "version": "0.1.0",
  "private": true,
  "description": "Open re-implementation of the Positive Grid Spark amp Bluetooth protocol, with a Web Bluetooth control UI.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "node --test test/*.test.js",
    "serve": "node tools/serve.js",
    "decode": "node tools/btsnoop-decode.js",
    "deploy": "wrangler deploy",
    "desktop": "electron .",
    "desktop:mock": "electron . --mock",
    "desktop:dist": "electron-builder",
    "mobile:sync": "cap sync",
    "android": "cap sync android && cap open android",
    "ios": "cap sync ios && cap open ios"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.js",
  "author": "Jeremy Meiss",
  "homepage": "https://github.com/jerdog/positive-grid-spark",
  "build": {
    "appId": "io.github.jerdog.sparkcontrol",
    "productName": "Spark Control",
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Spark Control uses Bluetooth to talk to your Spark amp."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    }
  },
  "devDependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "electron": "44.9.3",
    "electron-builder": "26.17.0"
  }
}
