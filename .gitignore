# dependencies
node_modules/

# Build artifacts
*.apk
*.aab
# No root build/ rule: build/ holds the committed desktop icons. android/ and ios/ ignore their own build output.
dist/
out/
screenshots/

# Environment / secrets (keep .env.example as the template)
.env
.env.*
!.env.example

# Signing & credentials
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
keystore.properties
google-services.json
GoogleService-Info.plist
credentials.json

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# Logs
*.log
!test/fixtures/*.log

# macOS
.DS_Store
# Official store material lives in the private repo (see AGENTS.md "Private resources")
/play-store/
/store/
/assets/store/

# wrangler local state
.wrangler/
